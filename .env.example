# This is a template. .env is ignored by Git.
# PowerShell `npm run api` does not automatically load .env: use process environment.
MSSQL_SA_PASSWORD=Local_Dev_Password1
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False
ASPNETCORE_ENVIRONMENT=Development
# Generate an independent, random signing key in the shell before starting the API.
# NEVER commit a real signing key (even in .env.example).
Jwt__Key=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
# Non-secret defaults in appsettings.json: Jwt__Issuer, Jwt__Audience, Jwt__LifetimeMinutes
# Local hashed credentials are seeded in Development only from DevelopmentAuth:DemoPassword.
